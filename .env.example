# Anthropic API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model yang dipakai APLIKASI untuk menulis dokumen. Kosongkan = claude-sonnet-5.
#
# CATATAN: ini TIDAK ada hubungannya dengan model yang dipakai Claude Code saat
# mengerjakan project ini (itu diatur lewat perintah /model). Dua-duanya terpisah.
#
# Biaya per 1M token (input/output), per 2026-07-15:
#   claude-sonnet-5   $3/$15  (intro $2/$10 s/d 2026-08-31)  <- default
#   claude-opus-4-8   $5/$25  (kualitas tertinggi)
#   claude-haiku-4-5  $1/$5   (paling murah, kualitas paling rendah)
LLM_MODEL=

# GitHub Personal Access Token with repo read scope - needed for private repos.
# Repo publik tetap jalan tanpa ini (batas 60 req/jam) — dan sejak ingestion
# pindah ke tarball, satu repo cuma makan ~3 request, jadi 60/jam sudah cukup
# untuk pemakaian ringan.
GITHUB_TOKEN=

# Lokasi SQLite untuk status job + dokumen hasil. Kosong = data/jobs.db (dibuat
# otomatis, di-gitignore). Sengaja BUKAN folder temp: generation itu async, dan
# seluruh guna DB ini adalah bertahan melewati response — bahkan melewati restart.
DATABASE_PATH=

# Path ke plantuml.jar — dipakai merender diagram secara LOKAL (butuh Java 17+
# di PATH). Kosong = tools/plantuml.jar (relatif root project). Unduh sekali:
# https://github.com/plantuml/plantuml/releases -> asset plantuml-<versi>.jar,
# simpan sebagai tools/plantuml.jar.
PLANTUML_JAR=

# Cuma perlu kalau mau flow OAuth GitHub beneran jalan (butuh GitHub OAuth App
# terdaftar — belum ada saat ini, lihat Keterbatasan di CLAUDE.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# --- Autentikasi (Supabase) --------------------------------------------------
# KOSONG = mode anonymous/dev: aplikasi jalan penuh tanpa login, semua job jadi
# milik "anonymous". Isi ketiganya untuk MENGHIDUPKAN isolasi per-pengguna —
# backend memverifikasi JWT Supabase dari frontend & memfilter data per-owner.
#
# SUPABASE_URL        : Project Settings -> API -> Project URL (https://<ref>.supabase.co)
# SUPABASE_JWT_SECRET : Project Settings -> API -> JWT Settings -> JWT Secret.
#                       Kosongkan kalau project pakai signing key ASIMETRIS baru
#                       (backend verifikasi lewat JWKS otomatis dari URL).
# SUPABASE_JWT_AUD    : audience token, Supabase memakai "authenticated" (default).
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=

# --- Rate limit per-akun ------------------------------------------------------
# Tiap /documents/generate = satu panggilan Claude BERBAYAR, jadi tanpa batas satu
# akun (atau token yang bocor) bisa membengkakkan tagihan. Batas dikunci ke
# identitas Supabase di atas — jadi HANYA berlaku kalau SUPABASE_URL diisi; mode
# dev sengaja tak dibatasi (semua pemanggil satu identitas anonim yang sama).
#
# Jendelanya SLIDING, bukan reset di jam bulat. Kosong = pakai default; 0 =
# MATIKAN batas untuk endpoint itu. Nilai tak masuk akal menggagalkan startup —
# batas yang salah-ketik tak boleh diam-diam jadi "tanpa batas".
#
# JANGAN taruh komentar di kanan tanda `=` yang nilainya kosong: python-dotenv
# membaca `KEY=   # catatan` sebagai nilai literal "# catatan", bukan kosong.
#
# RATE_LIMIT_WINDOW_SECONDS             : default 3600 (1 jam)
# RATE_LIMIT_GENERATE_PER_WINDOW        : default 10 dokumen per jendela per akun
# RATE_LIMIT_TEMPLATE_UPLOAD_PER_WINDOW : default 20 upload template per jendela
RATE_LIMIT_WINDOW_SECONDS=
RATE_LIMIT_GENERATE_PER_WINDOW=
RATE_LIMIT_TEMPLATE_UPLOAD_PER_WINDOW=
